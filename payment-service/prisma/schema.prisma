generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PaymentOrder{
  paymentId String @id @default(uuid())
  buyerAccount String
  amount String
  currency String
  transactionId String 
  transactionEvent PaymentEvent @relation(fields: [transactionId], references: [transactionId])
  paymentOrderStatus Boolean @default(false)
  ledgerUpdated Boolean @default(false)
  walletUpdated Boolean @default(false)
}

model PaymentEvent{
  transactionId String @id @default(uuid())
  customerId String
  sellerId String
  creditCardInformation String
  isPaymentDone Boolean @default(false)
  paymentOrder PaymentOrder[]
}


